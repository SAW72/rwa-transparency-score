# CoinMarketCap API key — get a free Basic key at https://coinmarketcap.com/api/
# Required only for live mode. Leave unset when using fixtures.
CMC_API_KEY=

# Optional. Used by the AI "Why this score?" explainer (xAI grok-4.1-fast).
# Leave unset to use the templated fallback. Never commit the key.
# Set it in the Render dashboard (sync: false) for live explanations.
XAI_API_KEY=

# HMAC-SHA256 key for signed score-card images. Never commit the real secret.
# Set in the Render dashboard (sync: false) or Bitwarden. Leave empty to
# generate unsigned cards (fingerprint UNSIGNED).
SCORE_CARD_SIGNING_SECRET=

# X (Twitter) API v2 user credentials — OAuth 1.0a. All four required to post.
# If any are missing, Share still generates + downloads the PNG and skips X.
# Set in the Render dashboard (sync: false) or Bitwarden. Never commit.
# Twitter-prefixed aliases (TWITTER_API_KEY, …) are also accepted.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Set to 1 to score from bundled demo fixtures (no live API, no credits).
RWA_USE_FIXTURES=1

# Optional JSON-RPC URLs for Chainlink Proof of Reserve (no API keys).
# Backed Finance publishes PoR feeds on Polygon today. Public no-key
# fallbacks are used when these are unset. Never commit a key or paid URL.
POLYGON_RPC_URL=
BASE_RPC_URL=
ETH_RPC_URL=

# --- Paid API (python -m rwa_score.api) ---
# SQLite path. Ephemeral on Render — use a disk or Postgres later.
# RWA_API_DB_PATH=data/rat_api.sqlite
# Optional bootstrap key (Spencer enters this; never commit the value).
# RWA_API_BOOTSTRAP_KEY=
# RWA_API_BOOTSTRAP_TIER=paid
# RWA_API_FREE_DAILY_LIMIT=50
# RWA_API_RATE_WINDOW_SECONDS=86400

# --- Base Sepolia attestation (no private keys here) ---
# RWA_ATTESTATION_CONTRACT=
# RWA_ATTESTATION_CHAIN=base-sepolia
# RWA_ATTESTATION_CHAIN_ID=84532
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
